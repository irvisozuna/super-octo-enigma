## 4 · Code Skeletons

### 4.1 Expandable Panel

```vue
<!-- ExpandablePanelMolecule.vue -->
<template>
  <div class="d-flex align-center">
    <VBtn icon size="x-small" @click="expanded = !expanded">
      <VIcon :icon="expanded ? 'tabler-chevron-up' : 'tabler-chevron-down'" />
    </VBtn>
    <slot name="summary" />
  </div>

  <VExpandTransition>
    <div v-show="expanded" class="pa-4">
      <slot />
    </div>
  </VExpandTransition>
</template>
```

### 4.2 Dialog Template

```vue
<!-- ModalTemplate.vue -->
<template>
  <VDialog v-model="open" max-width="640">
    <VCard>
      <DialogHeaderMolecule :title="title" @close="open = false" />

      <VCardText>
        <slot />
      </VCardText>

      <VCardActions class="justify-end">
        <VBtn text @click="open = false">{{ t('common.cancel') }}</VBtn>
        <VBtn color="primary" @click="$emit('confirm')">{{ t('common.save') }}</VBtn>
      </VCardActions>
    </VCard>
  </VDialog>
</template>
```

### 4.3 Tabs Header

```vue
<!-- TabsHeaderMolecule.vue -->
<template>
  <VTabs v-model="modelValue" class="mb-4" show-arrows>
    <template v-for="tab in tabs" :key="tab.value">
      <VTab :value="tab.value">
        <VIcon :icon="tab.icon" start />
        {{ tab.label }}
      </VTab>
    </template>
  </VTabs>
</template>
```

### 4.4 Stepper Organism

```vue
<!-- StepperOrganism.vue -->
<template>
  <VStepper v-model="step">
    <template v-for="(item, i) in steps" :key="i">
      <VStepperHeader>
        <VStepperStep :complete="step > i + 1" :step="i + 1">{{ item.label }}</VStepperStep>
      </VStepperHeader>
      <VStepperContent>
        <component :is="item.component" @valid="valid = $event" />
        <div class="d-flex justify-space-between mt-4">
          <VBtn text :disabled="step === 1" @click="step--">{{ t('common.back') }}</VBtn>
          <VBtn color="primary" :disabled="!valid" @click="next">{{ nextLabel }}</VBtn>
        </div>
      </VStepperContent>
    </template>
  </VStepper>
</template>
```

