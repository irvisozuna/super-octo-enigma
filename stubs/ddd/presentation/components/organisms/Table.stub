<template>
  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
{{#each properties}}
          {{#unless primary}}
          <th
            scope="col"
            class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"
          >
            {{@key}}
          </th>
          {{/unless}}
{{/each}}
          <th scope="col" class="relative px-6 py-3">
            <span class="sr-only">Acciones</span>
          </th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <tr v-for="{{entityNameLower}} in {{entityNameLower}}s" :key="{{entityNameLower}}.id">
{{#each properties}}
          {{#unless primary}}
          <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
            {{#if type === 'boolean'}}
            <span :class="{{entityNameLower}}.{{@key}} ? 'text-green-600' : 'text-red-600'">
              {{ {{entityNameLower}}.{{@key}} ? 'Sí' : 'No' }}
            </span>
            {{else if type === 'datetime'}}
            {{ formatDate({{entityNameLower}}.{{@key}}) }}
            {{else}}
            {{ {{entityNameLower}}.{{@key}} }}
            {{/if}}
          </td>
          {{/unless}}
{{/each}}
          <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
            <button
              @click="$emit('edit', {{entityNameLower}})"
              class="text-indigo-600 hover:text-indigo-900 mr-3"
            >
              Editar
            </button>
            <button
              @click="$emit('delete', {{entityNameLower}}.id)"
              class="text-red-600 hover:text-red-900"
            >
              Eliminar
            </button>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</template>

<script setup lang="ts">
import { computed } from 'vue'
import type { {{entityName}} } from '@/modules/{{moduleNameLower}}/domain/entities/{{entityName}}'

interface Props {
  {{entityNameLower}}s: {{entityName}}[]
  loading?: boolean
}

interface Emits {
  (e: 'edit', {{entityNameLower}}: {{entityName}}): void
  (e: 'delete', id: string): void
}

const props = defineProps<Props>()
const emit = defineEmits<Emits>()

const formatDate = (date: string | Date) => {
  if (!date) return '-'
  return new Date(date).toLocaleDateString()
}
</script> 
