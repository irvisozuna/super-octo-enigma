<template>
  <v-form ref="formRef" v-model="isValid" @submit.prevent="handleSubmit">
    <v-card>
      <v-card-title class="d-flex align-center justify-space-between">
        <span>{{ isEdit ? 'Edit' : 'Create' }} {{entityName}}</span>
        <v-btn icon @click="$emit('close')">
          <v-icon>mdi-close</v-icon>
        </v-btn>
      </v-card-title>

      <v-card-text>
        <v-row>
          {{#each entitySpec.properties}}
          {{#unless primary}}
          <v-col cols="12" {{#if type === 'text'}}md="12"{{else}}md="6"{{/if}}>
            {{#if type === 'enum'}}
            <v-select
              v-model="form.{{@key}}"
              :items="{{@key}}Options"
              :label="$t('{{../moduleNameLower}}.{{@key}}')"
              :rules="rules.{{@key}}"
              :error-messages="errors.{{@key}}"
              :disabled="loading"
              {{#if required}}required{{/if}}
              clearable
            />
            {{else if type === 'boolean'}}
            <v-switch
              v-model="form.{{@key}}"
              :label="$t('{{../moduleNameLower}}.{{@key}}')"
              :disabled="loading"
              {{#if required}}required{{/if}}
            />
            {{else if type === 'text'}}
            <v-textarea
              v-model="form.{{@key}}"
              :label="$t('{{../moduleNameLower}}.{{@key}}')"
              :rules="rules.{{@key}}"
              :error-messages="errors.{{@key}}"
              :disabled="loading"
              {{#if required}}required{{/if}}
              rows="4"
              auto-grow
            />
            {{else if type === 'integer'}}
            <v-text-field
              v-model.number="form.{{@key}}"
              :label="$t('{{../moduleNameLower}}.{{@key}}')"
              :rules="rules.{{@key}}"
              :error-messages="errors.{{@key}}"
              :disabled="loading"
              {{#if required}}required{{/if}}
              type="number"
            />
            {{else if type === 'datetime'}}
            <v-datetime-picker
              v-model="form.{{@key}}"
              :label="$t('{{../moduleNameLower}}.{{@key}}')"
              :rules="rules.{{@key}}"
              :error-messages="errors.{{@key}}"
              :disabled="loading"
              {{#if required}}required{{/if}}
            />
            {{else if type === 'json'}}
            <v-textarea
              v-model="form.{{@key}}"
              :label="$t('{{../moduleNameLower}}.{{@key}}')"
              :rules="rules.{{@key}}"
              :error-messages="errors.{{@key}}"
              :disabled="loading"
              {{#if required}}required{{/if}}
              rows="6"
              auto-grow
              placeholder="Enter JSON data..."
            />
            {{else}}
            <v-text-field
              v-model="form.{{@key}}"
              :label="$t('{{../moduleNameLower}}.{{@key}}')"
              :rules="rules.{{@key}}"
              :error-messages="errors.{{@key}}"
              :disabled="loading"
              {{#if required}}required{{/if}}
              {{#if encrypted}}type="password"{{/if}}
            />
            {{/if}}
          </v-col>
          {{/unless}}
          {{/each}}
        </v-row>

        {{#if relationships}}
        <!-- Relationship fields -->
        <v-row>
          {{#each relationships}}
          {{#if hasMany}}
          <v-col cols="12" md="6">
            <v-select
              v-model="form.{{@key}}_ids"
              :items="{{@key}}Options"
              :label="$t('{{../moduleNameLower}}.{{@key}}')"
              :loading="loading{{@key}}"
              :disabled="loading"
              multiple
              chips
              clearable
            />
          </v-col>
          {{else if belongsTo}}
          <v-col cols="12" md="6">
            <v-select
              v-model="form.{{@key}}_id"
              :items="{{@key}}Options"
              :label="$t('{{../moduleNameLower}}.{{@key}}')"
              :loading="loading{{@key}}"
              :disabled="loading"
              {{#if required}}required{{/if}}
              clearable
            />
          </v-col>
          {{/if}}
          {{/each}}
        </v-row>
        {{/if}}
      </v-card-text>

      <v-card-actions class="pa-4">
        <v-spacer />
        <v-btn
          color="grey"
          variant="text"
          :disabled="loading"
          @click="$emit('cancel')"
        >
          {{ $t('common.cancel') }}
        </v-btn>
        <v-btn
          color="primary"
          type="submit"
          :loading="loading"
          :disabled="!isValid"
        >
          {{ isEdit ? $t('common.update') : $t('common.create') }}
        </v-btn>
      </v-card-actions>
    </v-card>
  </v-form>
</template>

<script setup lang="ts">
import { ref, reactive, computed, onMounted, watch } from 'vue'
import { useI18n } from 'vue-i18n'
import { use{{entityName}}Store } from '@/modules/{{moduleNameLower}}/stores/{{entityNameLower}}Store'
import { use{{moduleName}}Validation } from '@/modules/{{moduleNameLower}}/composables/use{{moduleName}}Validation'
import type { {{entityName}} } from '@/modules/{{moduleNameLower}}/types/entities'

// Props
interface Props {
  {{entityNameLower}}?: {{entityName}}
  mode?: 'create' | 'edit'
}

const props = withDefaults(defineProps<Props>(), {
  mode: 'create'
})

// Emits
const emit = defineEmits<{
  submit: [data: any]
  cancel: []
  close: []
}>()

// Composables
const { t } = useI18n()
const {{entityNameLower}}Store = use{{entityName}}Store()
const { validate{{entityName}}, {{entityNameLower}}Schema } = use{{moduleName}}Validation()

// Refs
const formRef = ref()
const isValid = ref(false)
const loading = ref(false)

// Form data
const form = reactive({
  {{#each entitySpec.properties}}
  {{#unless primary}}
  {{@key}}: {{#if type === 'boolean'}}false{{else if type === 'integer'}}0{{else if type === 'json'}}{}{{else}}''{{/if}},
  {{/unless}}
  {{/each}}
  {{#each relationships}}
  {{#if hasMany}}
  {{@key}}_ids: [] as string[],
  {{else if belongsTo}}
  {{@key}}_id: '' as string,
  {{/if}}
  {{/each}}
})

// Validation rules
const rules = reactive({
  {{#each entitySpec.properties}}
  {{#unless primary}}
  {{@key}}: [
    {{#if required}}
    (v: any) => !!v || t('validations.required', { field: t('{{../moduleNameLower}}.{{@key}}') }),
    {{/if}}
    {{#if type === 'string'}}
    (v: string) => !v || v.length >= 3 || t('validation.minLength', { field: t('{{../moduleNameLower}}.{{@key}}'), min: 3 }),
    (v: string) => !v || v.length <= 255 || t('validation.maxLength', { field: t('{{../moduleNameLower}}.{{@key}}'), max: 255 }),
    {{/if}}
    {{#if type === 'integer'}}
    (v: number) => !v || v > 0 || t('validation.positive', { field: t('{{../moduleNameLower}}.{{@key}}') }),
    {{/if}}
    {{#if type === 'json'}}
    (v: string) => {
      if (!v) return true
      try {
        JSON.parse(v)
        return true
      } catch {
        return t('validation.invalidJson', { field: t('{{../moduleNameLower}}.{{@key}}') })
      }
    },
    {{/if}}
  ],
  {{/unless}}
  {{/each}}
})

// Computed
const isEdit = computed(() => props.mode === 'edit')

// Options for enum fields
{{#each entitySpec.properties}}
{{#if type === 'enum'}}
const {{@key}}Options = [
  {{#each values}}
  { text: t('{{../moduleNameLower}}.{{@key}}.{{this}}'), value: '{{this}}' },
  {{/each}}
]
{{/if}}
{{/each}}

// Relationship options
{{#each relationships}}
{{#if hasMany}}
const {{@key}}Options = ref([])
const loading{{@key}} = ref(false)
{{else if belongsTo}}
const {{@key}}Options = ref([])
const loading{{@key}} = ref(false)
{{/if}}
{{/each}}

// Methods
const load{{entityName}} = async () => {
  if (!props.{{entityNameLower}}?.id) return

  try {
    loading.value = true
    const data = await {{entityNameLower}}Store.fetch{{entityName}}ById(props.{{entityNameLower}}.id)
    
    // Populate form
    Object.keys(form).forEach(key => {
      if (data[key] !== undefined) {
        form[key] = data[key]
      }
    })
  } catch (error) {
    console.error('Error loading {{entityNameLower}}:', error)
  } finally {
    loading.value = false
  }
}

const loadRelationships = async () => {
  {{#each relationships}}
  {{#if hasMany}}
  try {
    loading{{@key}}.value = true
    // Load {{@key}} options
    // const response = await {{@key}}Store.fetch{{@key}}List()
    // {{@key}}Options.value = response.map(item => ({
    //   text: item.name,
    //   value: item.id
    // }))
  } catch (error) {
    console.error('Error loading {{@key}}:', error)
  } finally {
    loading{{@key}}.value = false
  }
  {{else if belongsTo}}
  try {
    loading{{@key}}.value = true
    // Load {{@key}} options
    // const response = await {{@key}}Store.fetch{{@key}}List()
    // {{@key}}Options.value = response.map(item => ({
    //   text: item.name,
    //   value: item.id
    // }))
  } catch (error) {
    console.error('Error loading {{@key}}:', error)
  } finally {
    loading{{@key}}.value = false
  }
  {{/if}}
  {{/each}}
}

const handleSubmit = async () => {
  if (!formRef.value?.validate()) return

  try {
    loading.value = true
    
    const formData = { ...form }
    
    // Validate with schema
    const validation = await validate{{entityName}}(formData)
    if (!validation.isValid) {
      Object.assign(errors, validation.errors)
      return
    }

    emit('submit', formData)
  } catch (error) {
    console.error('Error submitting form:', error)
  } finally {
    loading.value = false
  }
}

const resetForm = () => {
  formRef.value?.reset()
  Object.keys(form).forEach(key => {
    if (typeof form[key] === 'boolean') {
      form[key] = false
    } else if (typeof form[key] === 'number') {
      form[key] = 0
    } else if (Array.isArray(form[key])) {
      form[key] = []
    } else {
      form[key] = ''
    }
  })
}

// Watchers
watch(() => props.{{entityNameLower}}, (newValue) => {
  if (newValue && isEdit.value) {
    load{{entityName}}()
  } else {
    resetForm()
  }
}, { immediate: true })

// Lifecycle
onMounted(() => {
  loadRelationships()
})
</script>

<style scoped>
.v-card {
  max-width: 800px;
  margin: 0 auto;
}
</style> 
