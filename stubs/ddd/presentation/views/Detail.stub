<template>
  <VCard class="{{moduleNameKebab}}-detail">
    <VCardTitle class="d-flex justify-space-between align-center">
      <div>
        <h2 class="text-h4">{{ $t('{{moduleNameLower}}.detail.title') }}</h2>
        <p class="text-body-1 text-medium-emphasis">
          {{ $t('{{moduleNameLower}}.detail.description') }}
        </p>
      </div>
      <div class="d-flex gap-2">
        <VBtn
          color="primary"
          variant="outlined"
          prepend-icon="tabler-edit"
          @click="handleEdit"
        >
          {{ $t('{{moduleNameLower}}.actions.edit') }}
        </VBtn>
        <VBtn
          color="error"
          variant="outlined"
          prepend-icon="tabler-trash"
          @click="handleDelete"
        >
          {{ $t('{{moduleNameLower}}.actions.delete') }}
        </VBtn>
      </div>
    </VCardTitle>

    <VDivider />

    <VCardText v-if="isLoading">
      <VProgressCircular indeterminate />
    </VCardText>

    <VCardText v-else-if="!{{moduleNameLower}}">
      <VAlert type="error">
        {{ $t('{{moduleNameLower}}.detail.notFound') }}
      </VAlert>
    </VCardText>

    <VCardText v-else>
      <{{moduleName}}DetailCard :{{moduleNameLower}}="{{moduleNameLower}}" />
    </VCardText>
  </VCard>

  <!-- Diálogo de confirmación de eliminación -->
  <ConfirmDialog
    v-model="dialogs.delete"
    :title="$t('{{moduleNameLower}}.delete.title')"
    :message="$t('{{moduleNameLower}}.delete.message', { name: {{moduleNameLower}}?.name })"
    @confirm="handleDeleteConfirm"
  />
</template>

<script setup lang="ts">
import { ref, reactive, onMounted } from 'vue'
import { useRoute, useRouter } from 'vue-router'
import { use{{moduleName}}Store } from '../stores/{{moduleNameLower}}Store'
import { {{moduleName}}DTO } from '@/modules/{{moduleNameLower}}/application/dtos/{{moduleName}}DTO'
import {{moduleName}}DetailCard from '../components/organisms/{{moduleName}}DetailCard.vue'
import ConfirmDialog from '@/shared/components/ConfirmDialog.vue'
import { useNotification } from '@/composables/useNotification'

const route = useRoute()
const router = useRouter()
const {{moduleNameLower}}Store = use{{moduleName}}Store()
const { showSuccess, showError } = useNotification()

const {{moduleNameLower}} = ref<{{moduleName}}DTO | null>(null)
const isLoading = ref(false)

const dialogs = reactive({
  delete: false,
})

const handleEdit = () => {
  router.push({
    name: '{{moduleNameLower}}-edit',
    params: { id: route.params.id },
  })
}

const handleDelete = () => {
  dialogs.delete = true
}

const handleDeleteConfirm = async () => {
  try {
    await {{moduleNameLower}}Store.deleteItem({{moduleNameLower}}.value!.id)
    showSuccess($t('{{moduleNameLower}}.delete.success'))
    router.push({ name: '{{moduleNameLower}}-list' })
  } catch (error) {
    showError($t('{{moduleNameLower}}.delete.error'))
    console.error('Error deleting {{moduleNameLower}}:', error)
  } finally {
    dialogs.delete = false
  }
}

const load{{moduleName}} = async () => {
  try {
    isLoading.value = true
    const id = route.params.id as string
    {{moduleNameLower}}.value = await {{moduleNameLower}}Store.getItem(id)
  } catch (error) {
    showError($t('{{moduleNameLower}}.detail.loadError'))
    console.error('Error loading {{moduleNameLower}}:', error)
  } finally {
    isLoading.value = false
  }
}

onMounted(() => {
  load{{moduleName}}()
})
</script> 
