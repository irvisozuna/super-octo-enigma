  ) {}

  public async create(params: {
    name: string
    status?: string
  }): Promise<{{moduleName}}> {
    // Validar reglas de negocio antes de crear
    await this.specification.ensureCanCreate(params)

    const {{moduleNameLower}} = {{moduleName}}.create(params)
    await this.repository.save({{moduleNameLower}})

