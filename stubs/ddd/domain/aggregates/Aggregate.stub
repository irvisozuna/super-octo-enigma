    }
  ): Promise<{{moduleName}}> {
    const {{moduleNameLower}} = await this.findById(id)
    
    // Validar reglas de negocio antes de actualizar
    await this.specification.ensureCanUpdate({{moduleNameLower}}, params)

    {{moduleNameLower}}.update(params)
    await this.repository.save({{moduleNameLower}})

    return {{moduleNameLower}}
