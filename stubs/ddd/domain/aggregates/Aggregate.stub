  public async delete(id: string): Promise<void> {
    const {{moduleNameLower}} = await this.findById(id)
    
    // Validar reglas de negocio antes de eliminar
    await this.specification.ensureCanDelete({{moduleNameLower}})

    {{moduleNameLower}}.delete()
    await this.repository.save({{moduleNameLower}})
