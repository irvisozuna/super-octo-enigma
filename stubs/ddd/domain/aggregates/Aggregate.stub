  private async findById(id: string): Promise<{{moduleName}}> {
    const {{moduleNameLower}}Id = new {{moduleName}}Id(id)
    const {{moduleNameLower}} = await this.repository.findById({{moduleNameLower}}Id)

    if (!{{moduleNameLower}}) {
      throw new {{moduleName}}NotFound(id)
