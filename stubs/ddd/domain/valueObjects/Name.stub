import { ValueObject } from '@/shared/domain/ValueObject'
import { {{moduleName}}ValidationError } from '../exceptions/{{moduleName}}ValidationError'

export class {{moduleName}}Name extends ValueObject<string> {
  private static readonly MIN_LENGTH = 2
  private static readonly MAX_LENGTH = 100

  constructor(value: string) {
    super(value.trim())
    this.ensureIsValid()
  }

  private ensureIsValid(): void {
    if (!this.value) {
      throw new {{moduleName}}ValidationError('{{moduleName}} name cannot be empty')
    }

    if (this.value.length < {{moduleName}}Name.MIN_LENGTH) {
      throw new {{moduleName}}ValidationError(
        `{{moduleName}} name must be at least ${{{moduleName}}Name.MIN_LENGTH} characters`
      )
    }

    if (this.value.length > {{moduleName}}Name.MAX_LENGTH) {
      throw new {{moduleName}}ValidationError(
        `{{moduleName}} name must not exceed ${{{moduleName}}Name.MAX_LENGTH} characters`
      )
    }
  }

  public equals(other: {{moduleName}}Name): boolean {
    return this.value === other.value
  }

  public contains(searchTerm: string): boolean {
    return this.value.toLowerCase().includes(searchTerm.toLowerCase())
  }
} 
