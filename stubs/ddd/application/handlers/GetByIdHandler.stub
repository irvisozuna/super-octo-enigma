import { QueryHandler } from '@/shared/application/QueryHandler'
import { Get{{moduleName}}ByIdQuery, Get{{moduleName}}ByIdQueryImpl } from '../queries/Get{{moduleName}}ByIdQuery'
import { {{moduleName}}DTO } from '../dtos/{{moduleName}}DTO'
import { {{moduleName}}ApplicationService } from '../services/{{moduleName}}ApplicationService'
import { {{moduleName}}Mapper } from '../mappers/{{moduleName}}Mapper'
import { inject, injectable } from 'inversify'
import { TYPES } from '../../types'

@injectable()
export class Get{{moduleName}}ByIdHandler implements QueryHandler<Get{{moduleName}}ByIdQuery, {{moduleName}}DTO> {
  constructor(
    @inject(TYPES.{{moduleName}}ApplicationService)
    private readonly service: {{moduleName}}ApplicationService,
    @inject(TYPES.{{moduleName}}Mapper)
    private readonly mapper: {{moduleName}}Mapper
  ) {}

  async execute(query: Get{{moduleName}}ByIdQuery): Promise<{{moduleName}}DTO> {
    try {
      // Validar la query
      const validatedQuery = new Get{{moduleName}}ByIdQueryImpl(
        query.id,
        query.includeDeleted
      )

      // Ejecutar el caso de uso
      const {{moduleNameLower}} = await this.service.getById(validatedQuery)
      
      // Mapear a DTO
      return this.mapper.toDTO({{moduleNameLower}})
    } catch (error) {
      throw new Error(`Failed to get {{moduleName}} by ID: ${error.message}`)
    }
  }
} 
