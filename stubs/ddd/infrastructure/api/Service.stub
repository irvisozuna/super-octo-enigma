import { inject, injectable } from 'inversify'
import { TYPES } from '../../../types'
import { {{moduleName}}Endpoints } from './services/{{moduleName}}Endpoints'
import { {{moduleName}}Transformer } from './transformers/{{moduleName}}Transformer'
import { ApiResponse } from '@/shared/infrastructure/api/ApiResponse'
import { PaginatedResponse } from '@/shared/infrastructure/api/PaginatedResponse'

export interface {{moduleName}}ApiData {
  id?: string
  name: string
  status: string
  description?: string
  metadata?: Record<string, any>
  createdAt?: string
  updatedAt?: string
  deletedAt?: string
}

export interface {{moduleName}}ListParams {
  page?: number
  limit?: number
  search?: string
  status?: string
  sortBy?: string
  sortOrder?: 'asc' | 'desc'
  includeDeleted?: boolean
  filters?: Record<string, any>
}

export interface {{moduleName}}ListResponse extends PaginatedResponse<{{moduleName}}ApiData> {
  items: {{moduleName}}ApiData[]
  total: number
  page: number
  limit: number
}

@injectable()
export class {{moduleName}}ApiService {
  constructor(
    @inject(TYPES.{{moduleName}}Endpoints)
    private readonly endpoints: {{moduleName}}Endpoints,
    @inject(TYPES.{{moduleName}}Transformer)
    private readonly transformer: {{moduleName}}Transformer
  ) {}

  async create(data: {{moduleName}}ApiData): Promise<{{moduleName}}ApiData> {
    try {
      const response = await this.endpoints.create(data)
      return this.transformer.toApiData(response.data)
    } catch (error) {
      throw new Error(`Failed to create {{moduleName}} via API: ${error.message}`)
    }
  }

  async update(id: string, data: Partial<{{moduleName}}ApiData>): Promise<{{moduleName}}ApiData> {
    try {
      const response = await this.endpoints.update(id, data)
      return this.transformer.toApiData(response.data)
    } catch (error) {
      throw new Error(`Failed to update {{moduleName}} via API: ${error.message}`)
    }
  }

  async delete(id: string): Promise<void> {
    try {
      await this.endpoints.delete(id)
    } catch (error) {
      throw new Error(`Failed to delete {{moduleName}} via API: ${error.message}`)
    }
  }

  async getById(id: string, options?: { includeDeleted?: boolean }): Promise<{{moduleName}}ApiData | null> {
    try {
      const response = await this.endpoints.getById(id, options)
      return this.transformer.toApiData(response.data)
    } catch (error) {
      if (error.response?.status === 404) {
        return null
      }
      throw new Error(`Failed to get {{moduleName}} by ID via API: ${error.message}`)
    }
  }

  async getList(params: {{moduleName}}ListParams): Promise<{{moduleName}}ListResponse> {
    try {
      const response = await this.endpoints.getList(params)
      return {
        items: response.data.items.map(item => this.transformer.toApiData(item)),
        total: response.data.total,
        page: response.data.page,
        limit: response.data.limit
      }
    } catch (error) {
      throw new Error(`Failed to get {{moduleName}} list via API: ${error.message}`)
    }
  }

  async restore(id: string): Promise<{{moduleName}}ApiData> {
    try {
      const response = await this.endpoints.restore(id)
      return this.transformer.toApiData(response.data)
    } catch (error) {
      throw new Error(`Failed to restore {{moduleName}} via API: ${error.message}`)
    }
  }

  async export(format: 'excel' | 'pdf' = 'excel', params?: {{moduleName}}ListParams): Promise<Blob> {
    try {
      const response = await this.endpoints.export(format, params)
      return response.data
    } catch (error) {
      throw new Error(`Failed to export {{moduleName}}s via API: ${error.message}`)
    }
  }

  {{#if hasImport}}
  async import(file: File, options?: { 
    updateExisting?: boolean
    skipErrors?: boolean
  }): Promise<{
    imported: number
    errors: string[]
  }> {
    try {
      const formData = new FormData()
      formData.append('file', file)
      if (options?.updateExisting) {
        formData.append('updateExisting', 'true')
      }
      if (options?.skipErrors) {
        formData.append('skipErrors', 'true')
      }

      const response = await this.endpoints.import(formData)
      return response.data
    } catch (error) {
      throw new Error(`Failed to import {{moduleName}}s via API: ${error.message}`)
    }
  }
  {{/if}}

  async bulkDelete(ids: string[]): Promise<{
    deleted: number
    errors: string[]
  }> {
    try {
      const response = await this.endpoints.bulkDelete(ids)
      return response.data
    } catch (error) {
      throw new Error(`Failed to bulk delete {{moduleName}}s via API: ${error.message}`)
    }
  }

  async bulkUpdate(ids: string[], data: Partial<{{moduleName}}ApiData>): Promise<{
    updated: number
    errors: string[]
  }> {
    try {
      const response = await this.endpoints.bulkUpdate(ids, data)
      return response.data
    } catch (error) {
      throw new Error(`Failed to bulk update {{moduleName}}s via API: ${error.message}`)
    }
  }
} 
